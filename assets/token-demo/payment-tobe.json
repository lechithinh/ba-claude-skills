{
  "name": "Order payment (fixed)",
  "lanes": [
    {
      "id": "kh",
      "name": "Customer"
    },
    {
      "id": "ht",
      "name": "System"
    },
    {
      "id": "vh",
      "name": "Operations"
    }
  ],
  "pools": [
    {
      "id": "pay",
      "name": "Payment gateway",
      "position": "top"
    }
  ],
  "nodes": [
    {
      "id": "s",
      "type": "start",
      "lane": "kh",
      "name": "Customer taps Pay"
    },
    {
      "id": "t1",
      "type": "user_task",
      "lane": "kh",
      "name": "Choose payment method"
    },
    {
      "id": "t2",
      "type": "send_task",
      "lane": "ht",
      "name": "Send payment request"
    },
    {
      "id": "t3",
      "type": "receive_task",
      "lane": "ht",
      "name": "Receive payment result"
    },
    {
      "id": "g1",
      "type": "xor",
      "lane": "ht",
      "name": "Payment successful?"
    },
    {
      "id": "t4",
      "type": "service_task",
      "lane": "ht",
      "name": "Confirm order"
    },
    {
      "id": "e1",
      "type": "end",
      "lane": "ht",
      "name": "Order confirmed"
    },
    {
      "id": "t5",
      "type": "service_task",
      "lane": "ht",
      "name": "Release held stock"
    },
    {
      "id": "e2",
      "type": "end",
      "lane": "ht",
      "name": "Order cancelled"
    },
    {
      "id": "b1",
      "type": "boundary_timer",
      "attached_to": "t3",
      "interrupting": true,
      "name": "After 5 min"
    },
    {
      "id": "t6",
      "type": "service_task",
      "lane": "vh",
      "name": "Mark awaiting reconciliation"
    },
    {
      "id": "e3",
      "type": "end",
      "lane": "vh",
      "name": "Order awaiting reconciliation"
    }
  ],
  "flows": [
    {
      "from": "s",
      "to": "t1"
    },
    {
      "from": "t1",
      "to": "t2"
    },
    {
      "from": "t2",
      "to": "t3"
    },
    {
      "from": "t3",
      "to": "g1"
    },
    {
      "from": "g1",
      "to": "t4",
      "name": "Yes"
    },
    {
      "from": "t4",
      "to": "e1"
    },
    {
      "from": "g1",
      "to": "t5",
      "name": "No",
      "default": true
    },
    {
      "from": "t5",
      "to": "e2"
    },
    {
      "from": "b1",
      "to": "t6"
    },
    {
      "from": "t6",
      "to": "e3"
    }
  ],
  "messages": [
    {
      "id": "mreq",
      "from": "t2",
      "to": "pay",
      "name": "Payment request"
    },
    {
      "id": "mres",
      "from": "pay",
      "to": "t3",
      "name": "Transaction result"
    }
  ],
  "scenarios": [
    {
      "id": "A",
      "name": "Payment succeeds",
      "choices": {
        "g1": "Yes"
      },
      "expect": "e1"
    },
    {
      "id": "E",
      "name": "Payment gateway never replies",
      "silent": [
        "mres"
      ],
      "fire": [
        "b1"
      ],
      "expect": "e3"
    }
  ]
}