<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Participant_1" name="Gọi xe công nghệ" processRef="Process_1" />
    <bpmn:participant id="Pool_driver" name="Tài xế" />
    <bpmn:participant id="Pool_cust" name="Khách hàng" />
    <bpmn:messageFlow id="Msg_r1" name="Yêu cầu đặt xe" sourceRef="Pool_cust" targetRef="s" />
    <bpmn:messageFlow id="Msg_r2" name="Giá cước" sourceRef="t1" targetRef="Pool_cust" />
    <bpmn:messageFlow id="Msg_r3" name="Yêu cầu chuyến" sourceRef="t3" targetRef="Pool_driver" />
    <bpmn:messageFlow id="Msg_r4" name="Nhận chuyến" sourceRef="Pool_driver" targetRef="c1" />
    <bpmn:messageFlow id="Msg_r5" name="Thông tin tài xế" sourceRef="t4" targetRef="Pool_cust" />
    <bpmn:messageFlow id="Msg_r6" name="Không có xe" sourceRef="t5" targetRef="Pool_cust" />
  </bpmn:collaboration>
  <bpmn:process id="Process_1" isExecutable="false">
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="Lane_dp" name="Hệ thống điều phối">
        <bpmn:flowNodeRef>m1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>c1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>c2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g2</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_app" name="Ứng dụng">
        <bpmn:flowNodeRef>s</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e2</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="s" name="Nhận yêu cầu đặt xe">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
      <bpmn:messageEventDefinition id="s_def" />
    </bpmn:startEvent>
    <bpmn:sendTask id="t1" name="Tính và gửi giá cước">
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:exclusiveGateway id="m1" name="">
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:incoming>Flow_11</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="t2" name="Tìm tài xế gần nhất">
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sendTask id="t3" name="Gửi yêu cầu cho tài xế">
      <bpmn:incoming>Flow_4</bpmn:incoming>
      <bpmn:outgoing>Flow_5</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:eventBasedGateway id="g1" name="">
      <bpmn:incoming>Flow_5</bpmn:incoming>
      <bpmn:outgoing>Flow_6</bpmn:outgoing>
      <bpmn:outgoing>Flow_7</bpmn:outgoing>
    </bpmn:eventBasedGateway>
    <bpmn:intermediateCatchEvent id="c1" name="Tài xế nhận chuyến">
      <bpmn:incoming>Flow_6</bpmn:incoming>
      <bpmn:outgoing>Flow_8</bpmn:outgoing>
      <bpmn:messageEventDefinition id="c1_def" />
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="c2" name="Hết 60 giây">
      <bpmn:incoming>Flow_7</bpmn:incoming>
      <bpmn:outgoing>Flow_10</bpmn:outgoing>
      <bpmn:timerEventDefinition id="c2_def" />
    </bpmn:intermediateCatchEvent>
    <bpmn:exclusiveGateway id="g2" name="Đã thử 3 tài xế?">
      <bpmn:incoming>Flow_10</bpmn:incoming>
      <bpmn:outgoing>Flow_11</bpmn:outgoing>
      <bpmn:outgoing>Flow_12</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sendTask id="t4" name="Thông báo tài xế đang đến">
      <bpmn:incoming>Flow_8</bpmn:incoming>
      <bpmn:outgoing>Flow_9</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="e1" name="Đã ghép chuyến">
      <bpmn:incoming>Flow_9</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sendTask id="t5" name="Báo không tìm được xe">
      <bpmn:incoming>Flow_12</bpmn:incoming>
      <bpmn:outgoing>Flow_13</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="e2" name="Không có xe">
      <bpmn:incoming>Flow_13</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_1" sourceRef="s" targetRef="t1" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="t1" targetRef="m1" />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="m1" targetRef="t2" />
    <bpmn:sequenceFlow id="Flow_4" sourceRef="t2" targetRef="t3" />
    <bpmn:sequenceFlow id="Flow_5" sourceRef="t3" targetRef="g1" />
    <bpmn:sequenceFlow id="Flow_6" sourceRef="g1" targetRef="c1" />
    <bpmn:sequenceFlow id="Flow_7" sourceRef="g1" targetRef="c2" />
    <bpmn:sequenceFlow id="Flow_8" sourceRef="c1" targetRef="t4" />
    <bpmn:sequenceFlow id="Flow_9" sourceRef="t4" targetRef="e1" />
    <bpmn:sequenceFlow id="Flow_10" sourceRef="c2" targetRef="g2" />
    <bpmn:sequenceFlow id="Flow_11" name="Chưa" sourceRef="g2" targetRef="m1" />
    <bpmn:sequenceFlow id="Flow_12" name="Rồi" sourceRef="g2" targetRef="t5" />
    <bpmn:sequenceFlow id="Flow_13" sourceRef="t5" targetRef="e2" />
  </bpmn:process>
