<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Participant_1" name="Đăng ký &amp; eKYC mở tài khoản – ngân hàng số" processRef="Process_1" />
  </bpmn:collaboration>
  <bpmn:process id="Process_1" isExecutable="false">
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="Lane_kh" name="Khách hàng">
        <bpmn:flowNodeRef>s</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t2</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_app" name="App ngân hàng">
        <bpmn:flowNodeRef>t3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_ekyc" name="eKYC Provider">
        <bpmn:flowNodeRef>t4</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_td" name="Thẩm định">
        <bpmn:flowNodeRef>t7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e2</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="s" name="Khách muốn mở tài khoản">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="t1" name="Nhập thông tin cá nhân">
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="t2" name="Chụp giấy tờ và khuôn mặt">
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="t3" name="Gửi hồ sơ xác thực">
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="t4" name="Đối chiếu CCCD và liveness">
      <bpmn:incoming>Flow_4</bpmn:incoming>
      <bpmn:outgoing>Flow_5</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="g1" name="Kết quả khớp?" default="Flow_7">
      <bpmn:incoming>Flow_5</bpmn:incoming>
      <bpmn:outgoing>Flow_6</bpmn:outgoing>
      <bpmn:outgoing>Flow_7</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="t5" name="Tạo tài khoản trên Core">
      <bpmn:incoming>Flow_6</bpmn:incoming>
      <bpmn:incoming>Flow_11</bpmn:incoming>
      <bpmn:outgoing>Flow_8</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sendTask id="t6" name="Thông báo kích hoạt">
      <bpmn:incoming>Flow_8</bpmn:incoming>
      <bpmn:outgoing>Flow_9</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="e1" name="Tài khoản đã kích hoạt">
      <bpmn:incoming>Flow_9</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="t7" name="Thẩm định hồ sơ thủ công">
      <bpmn:incoming>Flow_7</bpmn:incoming>
      <bpmn:outgoing>Flow_10</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="g2" name="Hồ sơ được duyệt?" default="Flow_12">
      <bpmn:incoming>Flow_10</bpmn:incoming>
      <bpmn:outgoing>Flow_11</bpmn:outgoing>
      <bpmn:outgoing>Flow_12</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="e2" name="Hồ sơ bị từ chối">
      <bpmn:incoming>Flow_12</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_1" sourceRef="s" targetRef="t1" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="t1" targetRef="t2" />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="t2" targetRef="t3" />
    <bpmn:sequenceFlow id="Flow_4" sourceRef="t3" targetRef="t4" />
    <bpmn:sequenceFlow id="Flow_5" sourceRef="t4" targetRef="g1" />
    <bpmn:sequenceFlow id="Flow_6" name="Khớp" sourceRef="g1" targetRef="t5" />
    <bpmn:sequenceFlow id="Flow_7" name="Không khớp" sourceRef="g1" targetRef="t7" />
    <bpmn:sequenceFlow id="Flow_8" sourceRef="t5" targetRef="t6" />
    <bpmn:sequenceFlow id="Flow_9" sourceRef="t6" targetRef="e1" />
    <bpmn:sequenceFlow id="Flow_10" sourceRef="t7" targetRef="g2" />
    <bpmn:sequenceFlow id="Flow_11" name="Duyệt" sourceRef="g2" targetRef="t5" />
    <bpmn:sequenceFlow id="Flow_12" name="Từ chối" sourceRef="g2" targetRef="e2" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_1">
    <bpmndi:BPMNPlane id="Plane_1" bpmnElement="Collaboration_1">
      <bpmndi:BPMNShape id="Participant_1_di" bpmnElement="Participant_1" isHorizontal="true">
