<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Participant_1" name="Mua đồ uống tại quầy" processRef="Process_1" />
  </bpmn:collaboration>
  <bpmn:process id="Process_1" isExecutable="false">
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="Lane_kh" name="Khách hàng">
        <bpmn:flowNodeRef>s</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_nv" name="Nhân viên quầy">
        <bpmn:flowNodeRef>t2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e2</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="s" name="Khách tới quầy">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="t1" name="Gọi món">
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="t2" name="Kiểm tra món còn không">
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="g1" name="Còn món?">
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
      <bpmn:outgoing>Flow_5</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="t3" name="Thu tiền và giao món">
      <bpmn:incoming>Flow_4</bpmn:incoming>
      <bpmn:outgoing>Flow_6</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="e1" name="Khách nhận món">
      <bpmn:incoming>Flow_6</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="e2" name="Khách không mua">
      <bpmn:incoming>Flow_5</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_1" sourceRef="s" targetRef="t1" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="t1" targetRef="t2" />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="t2" targetRef="g1" />
    <bpmn:sequenceFlow id="Flow_4" name="Còn" sourceRef="g1" targetRef="t3" />
    <bpmn:sequenceFlow id="Flow_5" name="Hết" sourceRef="g1" targetRef="e2" />
    <bpmn:sequenceFlow id="Flow_6" sourceRef="t3" targetRef="e1" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_1">
    <bpmndi:BPMNPlane id="Plane_1" bpmnElement="Collaboration_1">
      <bpmndi:BPMNShape id="Participant_1_di" bpmnElement="Participant_1" isHorizontal="true">
        <dc:Bounds x="0" y="0" width="1170" height="420" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_kh_di" bpmnElement="Lane_kh" isHorizontal="true">
        <dc:Bounds x="30" y="0" width="1140" height="160" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_nv_di" bpmnElement="Lane_nv" isHorizontal="true">
        <dc:Bounds x="30" y="160" width="1140" height="260" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="s_di" bpmnElement="s">
        <dc:Bounds x="157" y="62" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="132" y="102" width="86" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="t1_di" bpmnElement="t1">
        <dc:Bounds x="290" y="45" width="110" height="70" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="t2_di" bpmnElement="t2">
        <dc:Bounds x="460" y="205" width="110" height="70" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="g1_di" bpmnElement="g1" isMarkerVisible="true">
        <dc:Bounds x="660" y="215" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="635" y="269" width="100" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="t3_di" bpmnElement="t3">
        <dc:Bounds x="800" y="205" width="110" height="70" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="e1_di" bpmnElement="e1">
        <dc:Bounds x="1007" y="222" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="982" y="262" width="86" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="e2_di" bpmnElement="e2">
        <dc:Bounds x="837" y="322" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="812" y="362" width="86" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_1_di" bpmnElement="Flow_1">
        <di:waypoint x="193" y="80" />
        <di:waypoint x="290" y="80" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_2_di" bpmnElement="Flow_2">
        <di:waypoint x="400" y="80" />
        <di:waypoint x="430" y="80" />
        <di:waypoint x="430" y="240" />
        <di:waypoint x="460" y="240" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_3_di" bpmnElement="Flow_3">
        <di:waypoint x="570" y="240" />
        <di:waypoint x="660" y="240" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_4_di" bpmnElement="Flow_4">
        <di:waypoint x="710" y="240" />
